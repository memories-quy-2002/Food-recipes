{
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["vite/client", "node"]
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"vite-env.d.ts",
		"vite.config.ts"
	]
}
