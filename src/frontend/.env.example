# Frontend public environment variables loaded by Vite.
# Never put private keys, database URLs, or JWT signing secrets here.
VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_RECIPE_BUCKET=recipe-images
# Optional Sentry error monitoring. Leave VITE_SENTRY_DSN empty to disable it locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
