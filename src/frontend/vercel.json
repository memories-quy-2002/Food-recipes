{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": {
			"master": true,
			"*": false
		}
	},
	"buildCommand": "pnpm build",
	"outputDirectory": "dist",
	"rewrites": [
		{
			"source": "/((?!assets/|favicon.ico|robots.txt|sitemap.xml).*)",
			"destination": "/index.html"
		}
	]
}
