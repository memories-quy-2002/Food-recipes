# Backend infrastructure environment. Copy to src/backend/.env for Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_recipes
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/food_recipes
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=3000
