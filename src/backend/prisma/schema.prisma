generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement()) @map("user_id")
  fullName  String    @map("full_name") @db.VarChar(124)
  password  String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  createdOn DateTime  @map("created_on") @db.Timestamp(6)
  lastLogin DateTime? @map("last_login") @db.Timestamp(6)
  phone     String?   @db.VarChar(20)
  address   String?   @db.VarChar(255)
  role      String    @default("user") @db.VarChar(16)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(6)

  @@map("accounts")
}

model Household {
  id        Int      @id @default(autoincrement()) @map("household_id")
  name      String   @db.VarChar(80)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("households")
}

model HouseholdMember {
  id          Int      @id @default(autoincrement()) @map("member_id")
  householdId Int      @map("household_id")
  userId      Int      @map("user_id")
  role        String   @default("MEMBER") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@unique([householdId, userId], map: "household_members_household_user_key")
  @@index([userId], map: "household_members_user_idx")
  @@map("household_members")
}

model HouseholdInvite {
  id          Int       @id @default(autoincrement()) @map("invite_id")
  householdId Int       @map("household_id")
  invitedBy   Int       @map("invited_by")
  email       String    @db.VarChar(255)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([householdId, email], map: "household_invites_household_email_idx")
  @@map("household_invites")
}

model Notification {
  id         Int       @id @default(autoincrement()) @map("notification_id")
  userId     Int       @map("user_id")
  kind       String    @db.VarChar(64)
  title      String    @db.VarChar(160)
  body       String?   @db.VarChar(500)
  actionPath String?   @map("action_path") @db.VarChar(255)
  dedupeKey  String    @map("dedupe_key") @db.VarChar(255)
  readAt     DateTime? @map("read_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([userId, dedupeKey], map: "notifications_user_dedupe_key")
  @@index([userId, readAt, createdAt], map: "notifications_user_read_created_idx")
  @@map("notifications")
}

model NotificationPreference {
  userId             Int      @id @map("user_id")
  pantryExpiry       Boolean  @default(true) @map("pantry_expiry")
  mealReminder       Boolean  @default(true) @map("meal_reminder")
  resumeCooking      Boolean  @default(true) @map("resume_cooking")
  weeklyPlan         Boolean  @default(true) @map("weekly_plan")
  householdActivity  Boolean  @default(true) @map("household_activity")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("notification_preferences")
}

model UserFoodPreference {
  userId                Int      @id @map("user_id")
  diet                  String?  @db.VarChar(32)
  cookingSkill          String?  @map("cooking_skill") @db.VarChar(16)
  maxWeekdayCookMinutes Int?     @map("max_weekday_cook_minutes")
  defaultServings       Int      @default(2) @map("default_servings")
  maxCaloriesPerServing Int?     @map("max_calories_per_serving")
  minProteinGrams       Float?   @map("min_protein_grams")
  strictDislikes        Boolean  @default(false) @map("strict_dislikes")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("user_food_preferences")
}

model UserAvoidedAllergen {
  id        Int      @id @default(autoincrement()) @map("avoidance_id")
  userId    Int      @map("user_id")
  allergen  String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([userId, allergen])
  @@index([userId])
  @@map("user_avoided_allergens")
}

model UserDislikedIngredient {
  id             Int      @id @default(autoincrement()) @map("dislike_id")
  userId         Int      @map("user_id")
  ingredientName String   @map("ingredient_name") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([userId, ingredientName])
  @@index([userId])
  @@map("user_disliked_ingredients")
}

model UserCuisinePreference {
  id        Int      @id @default(autoincrement()) @map("preference_id")
  userId    Int      @map("user_id")
  cuisine   String   @db.VarChar(64)
  weight    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([userId, cuisine])
  @@index([userId])
  @@map("user_cuisine_preferences")
}

model Category {
  id   Int    @id @default(autoincrement()) @map("category_id")
  name String @map("category_name") @db.VarChar(255)

  @@map("categories")
}

model Meal {
  id          Int     @id @default(autoincrement()) @map("meal_id")
  name        String  @map("meal_name") @db.VarChar(50)
  description String? @map("meal_description")

  @@map("meals")
}

model Recipe {
  id             Int                    @id @default(autoincrement()) @map("recipe_id")
  name           String?                @map("recipe_name") @db.VarChar(255)
  description    String?                @map("recipe_description")
  mealId         Int?                   @map("meal_id")
  categoryId     Int?                   @map("category_id")
  prepTimeMinutes Int?                  @map("prep_time_minutes")
  cookTimeMinutes Int?                  @map("cook_time_minutes")
  prepTime       Unsupported("interval")? @map("prep_time")
  cookTime       Unsupported("interval")? @map("cook_time")
  dateAdded      DateTime?              @default(now()) @map("date_added") @db.Timestamp(6)
  userId         Int                    @default(0) @map("user_id")
  imageUrl       String?                @map("image_url")
  ingredients    String[]
  instructions   String[]
  status         String                 @default("published") @db.VarChar(16)
  publishedAt    DateTime?              @map("published_at") @db.Timestamp(6)
  archivedAt     DateTime?              @map("archived_at") @db.Timestamp(6)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("recipes")
}

model RecipeIngredient {
  id           Int      @id @default(autoincrement()) @map("ingredient_id")
  recipeId     Int      @map("recipe_id")
  position     Int
  quantity     Decimal? @db.Decimal(12, 3)
  quantityText String?  @map("quantity_text") @db.VarChar(64)
  unit         String?  @db.VarChar(64)
  unitText     String?  @map("unit_text") @db.VarChar(64)
  name         String   @db.VarChar(255)
  preparation  String?  @db.VarChar(255)
  originalText String?  @map("original_text")
  note         String?  @db.VarChar(255)

  @@unique([recipeId, position], map: "recipe_ingredients_recipe_position_key")
  @@index([recipeId, position], map: "recipe_ingredients_recipe_position_idx")
  @@map("recipe_ingredients")
}

model RecipeNutrition {
  recipeId           Int      @id @map("recipe_id")
  servings           Int?
  caloriesPerServing Int?     @map("calories_per_serving")
  proteinGrams       Float?   @map("protein_grams")
  carbohydratesGrams Float?   @map("carbohydrates_grams")
  fatGrams           Float?   @map("fat_grams")
  fiberGrams         Float?   @map("fiber_grams")
  sugarGrams         Float?   @map("sugar_grams")
  sodiumMilligrams   Int?     @map("sodium_milligrams")
  source             String   @db.VarChar(32)
  sourceReference    String?  @map("source_reference") @db.VarChar(255)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("recipe_nutrition")
}

model RecipeDietaryTag {
  id       Int    @id @default(autoincrement()) @map("recipe_dietary_tag_id")
  recipeId Int    @map("recipe_id")
  tag      String @db.VarChar(64)

  @@unique([recipeId, tag], map: "recipe_dietary_tags_recipe_tag_key")
  @@index([recipeId], map: "recipe_dietary_tags_recipe_idx")
  @@map("recipe_dietary_tags")
}

model Wishlist {
  id        Int      @id @default(autoincrement()) @map("wishlist_id")
  userId    Int      @map("user_id")
  recipeId  Int      @map("recipe_id")
  dateAdded DateTime? @default(now()) @map("date_added") @db.Timestamp(6)

  @@unique([userId, recipeId], map: "user_recipe_constraint")
  @@map("wishlist")
}

model Rating {
  id        Int       @id @default(autoincrement()) @map("rating_id")
  userId    Int       @map("user_id")
  recipeId  Int       @map("recipe_id")
  score     Decimal?  @db.Decimal(10, 2)
  review    String?
  dateAdded DateTime? @default(now()) @map("date_added") @db.Timestamp(6)

  @@unique([userId, recipeId], map: "unique_user_recipe_pair")
  @@map("rating")
}

model SavedCollection {
  id        Int      @id @default(autoincrement()) @map("collection_id")
  userId    Int      @map("user_id")
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("saved_collections")
}

model SavedCollectionItem {
  id           Int      @id @default(autoincrement()) @map("collection_item_id")
  collectionId Int      @map("collection_id")
  recipeId     Int      @map("recipe_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([collectionId, recipeId], map: "saved_collection_recipe_key")
  @@map("saved_collection_items")
}

model ReviewReport {
  id             Int       @id @default(autoincrement()) @map("report_id")
  ratingId       Int       @map("rating_id")
  recipeId       Int       @map("recipe_id")
  reporterUserId Int       @map("reporter_user_id")
  reason         String    @db.VarChar(32)
  details        String?   @db.VarChar(1000)
  status         String    @default("open") @db.VarChar(16)
  resolutionNote String?   @map("resolution_note") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedBy     Int?      @map("resolved_by")

  @@map("review_reports")
}

model RecipeAllergen {
  id              Int      @id @default(autoincrement()) @map("allergen_id")
  recipeId        Int      @map("recipe_id")
  name            String   @db.VarChar(32)
  source          String   @db.VarChar(32)
  sourceReference String?  @map("source_reference") @db.VarChar(255)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@unique([recipeId, name], map: "recipe_allergens_recipe_name_key")
  @@index([recipeId, name], map: "recipe_allergens_recipe_idx")
  @@map("recipe_allergens")
}

model RecipeNote {
  id        Int      @id @default(autoincrement()) @map("note_id")
  userId    Int      @map("user_id")
  recipeId  Int      @map("recipe_id")
  note      String   @db.VarChar(2000)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@unique([userId, recipeId], map: "recipe_notes_user_recipe_key")
  @@index([recipeId], map: "recipe_notes_recipe_idx")
  @@map("recipe_notes")
}

model PantryItem {
  id              Int       @id @default(autoincrement()) @map("pantry_id")
  userId          Int?      @map("user_id")
  householdId     Int?      @map("household_id")
  name            String    @db.VarChar(255)
  have            Boolean   @default(true)
  quantity        Decimal?  @db.Decimal(12, 3)
  unit            String?   @db.VarChar(20)
  purchasedAt     DateTime? @map("purchased_at") @db.Date
  openedAt        DateTime? @map("opened_at") @db.Date
  expiresAt       DateTime? @map("expires_at") @db.Date
  storageLocation String?   @map("storage_location") @db.VarChar(32)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([userId, have], map: "pantry_items_user_have_idx")
  @@map("pantry_items")
}

model CookingIngredientUsage {
  id                  Int      @id @default(autoincrement()) @map("usage_id")
  historyId           Int      @map("history_id")
  userId              Int      @map("user_id")
  pantryId            Int?     @map("pantry_id")
  ingredientPosition  Int      @map("ingredient_position")
  ingredientName      String   @map("ingredient_name") @db.VarChar(255)
  requiredQuantity    Decimal  @map("required_quantity") @db.Decimal(12, 3)
  unit                String   @db.VarChar(20)
  deductedQuantity    Decimal  @map("deducted_quantity") @db.Decimal(12, 3)
  missingQuantity     Decimal  @map("missing_quantity") @db.Decimal(12, 3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([historyId, ingredientPosition], map: "cooking_ingredient_usage_history_position_key")
  @@index([userId, createdAt], map: "cooking_ingredient_usage_user_created_idx")
  @@map("cooking_ingredient_usage")
}

model MealPlan {
  id        Int      @id @default(autoincrement()) @map("plan_id")
  userId    Int?     @map("user_id")
  householdId Int?   @map("household_id")
  name      String   @db.VarChar(80)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("meal_plans")
}

model MealPlanItem {
  id           Int      @id @default(autoincrement()) @map("item_id")
  planId       Int      @map("plan_id")
  recipeId     Int      @map("recipe_id")
  plannedDate  DateTime @map("planned_date") @db.Date
  slot         String   @db.VarChar(16)
  servings     Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("meal_plan_items")
}

model ShoppingListItem {
  id             Int      @id @default(autoincrement()) @map("item_id")
  userId         Int?     @map("user_id")
  householdId    Int?     @map("household_id")
  label          String   @db.VarChar(255)
  quantity       String?  @db.VarChar(80)
  sourceRecipeId Int?     @map("source_recipe_id")
  checked        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("shopping_list_items")
}

model CookingHistory {
  id             Int      @id @default(autoincrement()) @map("history_id")
  userId         Int      @map("user_id")
  recipeId       Int      @map("recipe_id")
  mealPlanItemId Int?     @map("meal_plan_item_id")
  servings       Int      @default(1)
  startedAt      DateTime @map("started_at") @db.Timestamp(6)
  completedAt    DateTime @map("completed_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId, completedAt], map: "cooking_history_user_completed_idx")
  @@index([userId, recipeId], map: "cooking_history_user_recipe_idx")
  @@map("cooking_history")
}

model CookingSession {
  id             Int       @id @default(autoincrement()) @map("session_id")
  userId         Int       @map("user_id")
  recipeId       Int       @map("recipe_id")
  mealPlanItemId Int?      @map("meal_plan_item_id")
  servings       Int       @default(1)
  currentStep    Int       @default(0) @map("current_step")
  status         String    @default("active") @db.VarChar(16)
  startedAt      DateTime  @map("started_at") @db.Timestamp(6)
  lastActiveAt   DateTime  @default(now()) @map("last_active_at") @db.Timestamp(6)
  pausedAt       DateTime? @map("paused_at") @db.Timestamp(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([userId, status, updatedAt], map: "cooking_sessions_user_status_updated_idx")
  @@index([userId, recipeId, status], map: "cooking_sessions_user_recipe_status_idx")
  @@map("cooking_sessions")
}

model AuthSession {
  id         Int       @id @default(autoincrement()) @map("session_id")
  userId     Int       @map("user_id")
  familyId   String    @map("family_id") @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  persistent Boolean   @default(true) @map("persistent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)
  replacedBy Int?      @map("replaced_by")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement()) @map("token_id")
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(6)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement()) @map("token_id")
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(6)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}
