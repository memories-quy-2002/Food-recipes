# Backend-only environment variables. Copy to .env and fill in local values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_recipes
# Generate a local value with:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Brevo transactional email. Tests and local development can leave these unset;
# production startup requires both values. Verify AUTH_MAIL_FROM_EMAIL as a
# sender in Brevo before use. Domain authentication is recommended for branded
# delivery; Brevo may rewrite unauthenticated sender domains.
BREVO_API_KEY=
AUTH_MAIL_FROM_EMAIL=
AUTH_MAIL_FROM_NAME=Food Recipes
# Frontend origin used to build recovery and verification links; production
# startup requires it.
AUTH_PUBLIC_WEB_URL=http://localhost:5173
