# Backend-only environment variables. Copy to .env and fill in local values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_recipes
# Generate a local value with:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional recovery delivery webhook. Tests and local development can leave this unset.
AUTH_MAIL_WEBHOOK_URL=
# Optional frontend origin used to build recovery and verification links.
AUTH_PUBLIC_WEB_URL=http://localhost:5173
# Optional Sentry error monitoring. Leave SENTRY_DSN empty to disable it locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
