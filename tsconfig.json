{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/client/*"]
		},
		"types": ["vite/client", "node"]
	},
	"include": [
		"src/vite-env.d.ts",
		"src/client/shared/api/contracts.ts",
		"src/client/features/food/api/useRecipesQuery.ts",
		"src/client/features/food/api/useRecipesQuery.test.ts",
		"vite.config.ts"
	]
}
