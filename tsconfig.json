{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/client/*"]
		},
		"types": ["vite/client", "node"]
	},
	"include": [
		"src/client/**/*.ts",
		"src/client/**/*.tsx",
		"src/vite-env.d.ts",
		"vite.config.ts"
	],
	"exclude": ["src/backend", "src/server"]
}
