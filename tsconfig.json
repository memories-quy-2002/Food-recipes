{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/frontend/*"]
		},
		"types": ["vite/client", "node"]
	},
	"include": [
		"src/frontend/**/*.ts",
		"src/frontend/**/*.tsx",
		"src/frontend/vite-env.d.ts",
		"src/frontend/vite.config.ts"
	],
	"exclude": ["src/backend"]
}
